<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_dcalc"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_dcalc_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DotCalc">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DotCalc"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity-alias
            android:name=".LauncherDotCalc"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_dcalc"
            android:label="@string/app_name_dotcalc"
            android:roundIcon="@mipmap/ic_dcalc_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCalculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_dcalc"
            android:label="@string/app_name_calculator"
            android:roundIcon="@mipmap/ic_dcalc_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>